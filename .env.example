# Local demo only; no private contracts. Change credentials for other deployments.
POSTGRES_USER=traystack
POSTGRES_PASSWORD=traystack_local
POSTGRES_DB=traystack
API_PORT=8000
WEB_PORT=8080
# Within Compose, DB and storage settings are supplied automatically.
UPLOAD_MAX_BYTES=26214400
OCR_LANGUAGES=eng
# German and English packs are installed in the backend container.
# For both languages: OCR_LANGUAGES=eng+deu
OCR_TIMEOUT_SECONDS=30
PROCESSING_MAX_PAGES=100
